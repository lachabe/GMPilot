# ══════════════════════════════════════════════════════════════════════════════
# VulnScan Manager (GMPILOT) - Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ──── Flask ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key

# ──── GVM Connection ──────────────────────────────────────────────────────────
# Type de connexion : "socket" ou "tcp"
GVM_CONNECTION_TYPE=socket

# Pour socket (local)
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# Pour TCP (distant)
GVM_HOST=127.0.0.1
GVM_PORT=9390

# Timeout des requêtes GVM (en secondes)
GVM_TIMEOUT=300

# ──── Authentification ────────────────────────────────────────────────────────
# Backend d'authentification : "gmp" | "ldap" | "oidc"
AUTH_BACKEND=gmp

# ──── Compte de service GMP (requis pour LDAP et OIDC) ───────────────────────
# Ce compte est utilisé pour toutes les requêtes GVM après authentification
# Il doit avoir les permissions en lecture sur tasks/reports/vulns
# NE PAS UTILISER pour AUTH_BACKEND=gmp (les users utilisent leurs propres credentials)
GMP_SERVICE_ACCOUNT=
GMP_SERVICE_PASSWORD=

# ──── LDAP (si AUTH_BACKEND=ldap) ─────────────────────────────────────────────
# URL du serveur LDAP (ldap:// ou ldaps://)
AUTH_LDAP_URL=ldaps://ldap.example.com:636

# Compte de lecture LDAP (pour rechercher les utilisateurs)
AUTH_LDAP_BIND_DN=cn=readonly,dc=example,dc=com
AUTH_LDAP_BIND_PASSWORD=readonly-password

# Base DN pour la recherche des utilisateurs
AUTH_LDAP_BASE_DN=ou=users,dc=example,dc=com

# Filtre de recherche utilisateur ({username} sera remplacé)
# Exemples :
#   - Active Directory : (sAMAccountName={username})
#   - OpenLDAP : (uid={username})
AUTH_LDAP_USER_FILTER=(uid={username})

# Attributs LDAP à récupérer
AUTH_LDAP_ATTR_EMAIL=mail
AUTH_LDAP_ATTR_DISPLAYNAME=displayName

# StartTLS (pour ldap:// non-SSL)
AUTH_LDAP_START_TLS=false

# Validation du certificat SSL/TLS
AUTH_LDAP_VALIDATE_CERT=true

# ──── OIDC (si AUTH_BACKEND=oidc) ─────────────────────────────────────────────
# Issuer URL (ex: https://keycloak.example.com/realms/myrealm)
AUTH_OIDC_ISSUER=

# Client ID et Secret (configurés dans le provider OIDC)
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Redirect URI (doit correspondre à la config du provider)
# Format : https://your-gmpilot-domain.com/auth/callback
AUTH_OIDC_REDIRECT_URI=http://localhost:5000/auth/callback

# Scopes demandés (séparés par espaces)
AUTH_OIDC_SCOPE=openid email profile

# ══════════════════════════════════════════════════════════════════════════════
# Exemples de configuration
# ══════════════════════════════════════════════════════════════════════════════

# ──── Exemple 1 : GMP direct (défaut) ─────────────────────────────────────────
# AUTH_BACKEND=gmp
# → Les utilisateurs se connectent avec leurs comptes GVM
# → Pas besoin de GMP_SERVICE_ACCOUNT

# ──── Exemple 2 : LDAP + Compte de service GVM ────────────────────────────────
# AUTH_BACKEND=ldap
# AUTH_LDAP_URL=ldaps://ad.corp.example.com:636
# AUTH_LDAP_BIND_DN=CN=svc-gmpilot,OU=ServiceAccounts,DC=corp,DC=example,DC=com
# AUTH_LDAP_BIND_PASSWORD=super-secret
# AUTH_LDAP_BASE_DN=OU=Users,DC=corp,DC=example,DC=com
# AUTH_LDAP_USER_FILTER=(sAMAccountName={username})
# GMP_SERVICE_ACCOUNT=gvm-readonly
# GMP_SERVICE_PASSWORD=gvm-readonly-password

# ──── Exemple 3 : Keycloak OIDC ───────────────────────────────────────────────
# AUTH_BACKEND=oidc
# AUTH_OIDC_ISSUER=https://keycloak.example.com/realms/production
# AUTH_OIDC_CLIENT_ID=gmpilot
# AUTH_OIDC_CLIENT_SECRET=xxx-secret-from-keycloak
# AUTH_OIDC_REDIRECT_URI=https://gmpilot.example.com/auth/callback
# GMP_SERVICE_ACCOUNT=gvm-readonly
# GMP_SERVICE_PASSWORD=gvm-readonly-password

# ──── Exemple 4 : Azure AD OIDC ───────────────────────────────────────────────
# AUTH_BACKEND=oidc
# AUTH_OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
# AUTH_OIDC_CLIENT_ID=xxx-app-id-from-azure
# AUTH_OIDC_CLIENT_SECRET=xxx-secret-from-azure
# AUTH_OIDC_REDIRECT_URI=https://gmpilot.example.com/auth/callback
# AUTH_OIDC_SCOPE=openid email profile
# GMP_SERVICE_ACCOUNT=gvm-readonly
# GMP_SERVICE_PASSWORD=gvm-readonly-password
